{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "all",
      "displayName": "全部 (三块板固件 + 协议自测)",
      "description": "顶层工程: 宿主编译协议自测, ExternalProject 串起三个交叉固件",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {}
    }
  ],
  "buildPresets": [
    {
      "name": "all",
      "displayName": "编译全部固件 + 协议自测",
      "configurePreset": "all",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "all",
      "displayName": "跑协议库自测",
      "configurePreset": "all",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "all",
      "displayName": "配置 -> 编译 -> 自测",
      "steps": [
        { "type": "configure", "name": "all" },
        { "type": "build", "name": "all" },
        { "type": "test", "name": "all" }
      ]
    }
  ]
}
