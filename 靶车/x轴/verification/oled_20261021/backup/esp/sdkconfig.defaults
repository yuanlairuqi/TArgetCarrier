CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ROBOT_BATTERY_ENABLED=n
CONFIG_ROBOT_UART_ENABLED=y
CONFIG_ROBOT_UART_PORT=1
CONFIG_ROBOT_UART_TX_GPIO=4
CONFIG_ROBOT_UART_RX_GPIO=5
CONFIG_ROBOT_UART_BAUD=115200

CONFIG_ROBOT_PULSE_CAPTURE_ENABLED=y
CONFIG_ROBOT_PULSE_PUL_GPIO=6
CONFIG_ROBOT_PULSE_DIR_GPIO=7
