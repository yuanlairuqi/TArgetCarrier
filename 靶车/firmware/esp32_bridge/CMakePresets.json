{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "esp32-bridge",
      "displayName": "M5Stamp S3 桥接端 (ESP32-S3)",
      "description": "ESP-NOW -> UART 转发 + 看门狗。产物: build/firmware.bin",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/../../cmake/toolchain-esp32s3.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ESP32S3_VARIANT": "m5stack_stamp_s3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "esp32-bridge",
      "displayName": "编译桥接端",
      "configurePreset": "esp32-bridge"
    }
  ]
}
