option(TARGETCARRIER_OLED "Enable the local diagnostic OLED task" ON)
option(TARGETCARRIER_OLED_SH1106 "Use SH1106 instead of SSD1306" OFF)
set(TARGETCARRIER_OLED_HEIGHT "64" CACHE STRING "OLED height: 32 or 64")
set(TARGETCARRIER_OLED_ADDRESS "0" CACHE STRING "7-bit OLED address: 0 auto, 60 or 61")
set(TARGETCARRIER_OLED_PERIOD_MS "500" CACHE STRING "Refresh interval: 250..5000 ms")
if(NOT TARGETCARRIER_OLED_HEIGHT MATCHES "^(32|64)$")
    message(FATAL_ERROR "OLED height must be 32 or 64")
endif()
if(NOT TARGETCARRIER_OLED_ADDRESS MATCHES "^(0|60|61)$")
    message(FATAL_ERROR "OLED address must be decimal 0, 60 or 61")
endif()
if(NOT TARGETCARRIER_OLED_PERIOD_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "OLED period must be an integer")
endif()
if(TARGETCARRIER_OLED_PERIOD_MS LESS 250 OR TARGETCARRIER_OLED_PERIOD_MS GREATER 5000)
    message(FATAL_ERROR "OLED period must be 250..5000")
endif()
target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE APP_OLED_ENABLED=$<BOOL:${TARGETCARRIER_OLED}>)
if(TARGETCARRIER_OLED)
    target_sources(${CMAKE_PROJECT_NAME} PRIVATE App/Display/status_display.c App/Display/oled_text.c)
    target_include_directories(${CMAKE_PROJECT_NAME} PRIVATE App/Display)
    target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE
        APP_OLED_SH1106=$<BOOL:${TARGETCARRIER_OLED_SH1106}>
        APP_OLED_HEIGHT=${TARGETCARRIER_OLED_HEIGHT} APP_OLED_ADDRESS=${TARGETCARRIER_OLED_ADDRESS}
        APP_OLED_PERIOD_MS=${TARGETCARRIER_OLED_PERIOD_MS})
endif()
